{
  "name": "@dombaras/agent-board",
  "version": "0.1.0",
  "private": true,
  "description": "Shared, project-scoped development board service (ADR 0001). Standalone Next.js + Prisma app; not deployed into projects.",
  "scripts": {
    "dev": "next dev -p 3021",
    "build": "next build",
    "start": "next start -p 3021",
    "lint": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "test": "tsx --env-file=.env.test --test src/lib/*.test.ts",
    "migrate": "tsx --env-file=.env scripts/migrate-board.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "next": "^16.3.8",
    "pg": "^8.13.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^7.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
