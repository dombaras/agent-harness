# Board service database (separate database on the shared Postgres server).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agent_board?schema=public"

# Comma-separated `token:projectKey` pairs. One token per project/agent.
# The client sends `Authorization: Bearer <token>`; the token resolves the project.
BOARD_TOKENS="dev-libraryos-token:LibraryOS,dev-familybudget-token:FamilyBudget"
