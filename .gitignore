.DS_Store

# deployed harness artifacts (never commit a target deployment into this repo).
# Root-anchored so the TEMPLATE source (templates/.agents/, templates/.opencode/)
# stays tracked; only a root-level `init --target .` deployment is ignored.
/.harness.json
/.harness-backup/
/.agents/
/.opencode/
/opencode.json
/AGENTS.md

# dogfood install (`agent-harness dogfood`): the harness SOURCE checkout runs its
# own guard/tools via symlinks into templates/ — machine-local, never committed.
/scripts
/.harness-dogfood

# offline release artifacts (`npm run bundle`): versioned, not source.
/dist/
