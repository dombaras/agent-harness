{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "experimental": {
    "todo": true
  },
  "worktree": {
    "directory": "../.worktrees/{{PROJECT_DIR}}"
  },
  "agents": {
    "title": {
      "model": "opencode-go/glm-5.3-flash"
    },
    "build": {
      "steps": 120
    },
    "explore": {
      "model": "opencode-go/glm-5.3-flash",
      "steps": 40
    }
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "{{WORKSPACE_ROOT}}/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/AppData/Local/Temp/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.maestro/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.android/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.local/share/opencode/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.config/opencode/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.config/agent-harness/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/etc/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/proc/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.ssh/**",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/.aws/**",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/.gnupg/**",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/.config/gh/**",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/.docker/**",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/.kube/**",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/.netrc",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/.git-credentials",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/.config/opencode/auth.json",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/.local/share/opencode/auth.json",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.config/opencode/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.local/share/opencode/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.config/agent-harness/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.ssh/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.aws/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.gnupg/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.config/gh/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "/etc/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "/proc/**",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "sudo *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -rf /*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -rf ~",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -rf ~/*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -rf /tmp/*",
      "effect": "allow"
    }
  ],
  "policies": [
    { "action": "tool.use", "resource": "external_directory:*/.ssh/*", "effect": "deny" },
    { "action": "tool.use", "resource": "external_directory:*/.ssh", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.ssh/*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.ssh", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.ssh/*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.ssh", "effect": "deny" },
    { "action": "tool.use", "resource": "external_directory:*/.aws/*", "effect": "deny" },
    { "action": "tool.use", "resource": "external_directory:*/.aws", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.aws/*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.aws", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.aws/*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.aws", "effect": "deny" },
    { "action": "tool.use", "resource": "external_directory:*/.gnupg/*", "effect": "deny" },
    { "action": "tool.use", "resource": "external_directory:*/.gnupg", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.gnupg/*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.gnupg", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.gnupg/*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.gnupg", "effect": "deny" },
    { "action": "tool.use", "resource": "external_directory:*/.config/gh/*", "effect": "deny" },
    { "action": "tool.use", "resource": "external_directory:*/.config/gh", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.config/gh/*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.config/gh", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.config/gh/*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.config/gh", "effect": "deny" },
    { "action": "tool.use", "resource": "external_directory:*/.docker/*", "effect": "deny" },
    { "action": "tool.use", "resource": "external_directory:*/.docker", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.docker/*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.docker", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.docker/*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.docker", "effect": "deny" },
    { "action": "tool.use", "resource": "external_directory:*/.kube/*", "effect": "deny" },
    { "action": "tool.use", "resource": "external_directory:*/.kube", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.kube/*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.kube", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.kube/*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.kube", "effect": "deny" },
    { "action": "tool.use", "resource": "external_directory:*/.netrc", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.netrc", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.netrc", "effect": "deny" },
    { "action": "tool.use", "resource": "external_directory:*/.git-credentials", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.git-credentials", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.git-credentials", "effect": "deny" },
    { "action": "tool.use", "resource": "external_directory:*/.config/opencode/auth.json", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.config/opencode/auth.json", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.config/opencode/auth.json", "effect": "deny" },
    { "action": "tool.use", "resource": "external_directory:*/.local/share/opencode/auth.json", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.local/share/opencode/auth.json", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.local/share/opencode/auth.json", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.config/opencode/*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.local/share/opencode/*", "effect": "deny" },
    { "action": "mcp.use", "resource": "*", "effect": "deny" }
  ],
  "plugins": [
    "./.opencode/plugins/harness-version"
  ]
}
